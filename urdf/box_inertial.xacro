<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="__robotiq_hande_box_inertial" params="x y z mass *origin">
    <inertial>
      <mass value="${mass}"/>
      <xacro:insert_block name="origin"/>
      <inertia
        ixx="${0.0833333 * mass * ((y * y) + (z * z))}"
        ixy="0.0"
        ixz="0.0"
        iyy="${0.0833333 * mass * ((x * x) + (z * z))}"
        iyz="0.0"
        izz="${0.0833333 * mass * ((x * x) + (y * y))}"
      />
    </inertial>
  </xacro:macro>
</robot>
